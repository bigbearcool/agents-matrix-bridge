{
  "name": "agents-matrix-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified decentralized Matrix bridge for AI Agents (Antigravity, Codex, ZCode)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigbearcool/agents-matrix-bridge.git"
  },
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "build:ui": "node packages/matrix-console-ui/build.mjs",
    "build": "node scripts/build-and-sync.mjs",
    "sync": "node scripts/build-and-sync.mjs",
    "test:core": "node --test packages/matrix-core/tests/*.test.mjs",
    "test:adapters": "node --test adapters/tests/*.test.mjs",
    "test:codex": "(cd codex && node --test tests/*.test.mjs)",
    "test": "npm run test:core && npm run test:adapters && npm run test:codex"
  }
}
